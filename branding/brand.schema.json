{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-project-bootstrap/branding.brand.schema.json",
  "title": "BrandIconContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["icon", "icon_sha256", "source", "brand_name", "tokens"],
  "properties": {
    "icon": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative path to the canonical app icon PNG"
    },
    "icon_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the icon file; inheritance detector when it matches the template"
    },
    "source": {
      "type": "string",
      "enum": ["owned", "inherited", "missing", "placeholder"]
    },
    "brand_name": {
      "type": "string",
      "minLength": 1
    },
    "tokens": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative path to design tokens pointer JSON"
    }
  }
}
